# Configuration checklist for the Worker backend; no credentials included.
# npm run dev is a UI preview and does not read this file.
# Configure secrets using the chosen deployment host's secret store.
# AUTH_DB is a Cloudflare D1 binding object, not a string environment variable.

# Sign-in/session signing: set a unique random value of at least 32 characters.
AUTH_SECRET=

# Email verification (requires a verified sender at the email provider).
RESEND_API_KEY=
AUTH_EMAIL_FROM=

# Optional AI backend. Keep these credentials server-side.
OPENAI_API_KEY=
# Blank model overrides use the defaults in worker/index.js.
OPENAI_CHAT_MODEL=
OPENAI_SCAN_MODEL=
OPENAI_TRANSCRIPTION_MODEL=
OPENAI_REALTIME_TRANSCRIPTION_MODEL=

# Optional retained live billing backend ONLY.
# Current shop/subscription UI uses simulated checkout and does not charge money.
# Adding keys does not switch the current demo UI to live billing.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PLUS_ANNUAL=
STRIPE_PRICE_PAWPRINT_ONE=
STRIPE_SHIPPING_RATE=
STRIPE_SHIPPING_COUNTRIES=
